// Prisma Schema for MoveInBD Backend REST API Server
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User Roles
enum Role {
  TENANT_USER
  PROVIDER
  ADMIN
}

// Property Types
enum PropertyType {
  FLAT
  SUBLET
  MESS
}

// Vehicle Types
enum VehicleType {
  PICKUP_TRUCK
  COVERED_VAN
  PASSENGER_CAR
  MICROBUS
}

// Booking Types
enum BookingType {
  HOUSE_SHIFTING
  PASSENGER_TRAVEL
}

// Booking Statuses
enum BookingStatus {
  PENDING
  ACCEPTED
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

// Escrow Statuses
enum EscrowStatus {
  HELD
  RELEASED
  REFUNDED
}

// Utility Bill Statuses
enum UtilityStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

// Payment Types
enum PaymentType {
  RENT
  UTILITY
  TRANSPORT_BOOKING
}

// Payment Gateways
enum PaymentGateway {
  BKASH
  STRIPE
  SSLCOMMERZ
}

// Payment Statuses
enum PaymentStatus {
  INITIATED
  SUCCESS
  FAILED
  CANCELLED
}

// Model: User
model User {
  id               String             @id @default(uuid())
  name             String
  email            String             @unique
  password         String
  phone            String?
  role             Role               @default(TENANT_USER)
  isVerified       Boolean            @default(false)
  avatar           String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  deletedAt        DateTime?

  properties       Property[]         @relation("LandlordProperties")
  utilityBills     UtilityBill[]      @relation("LandlordUtilityBills")
  utilityPayments  UtilityPayment[]   @relation("TenantUtilityPayments")
  vehicles         Vehicle[]          @relation("OwnerVehicles")
  bookings         TransportBooking[] @relation("TenantBookings")
  payments         Payment[]          @relation("UserPayments")
  auditLogs        AuditLog[]         @relation("UserAuditLogs")

  @@index([email])
  @@index([role])
}

// Model: Property (Housing, Sublet, Mess)
model Property {
  id           String       @id @default(uuid())
  landlordId   String
  landlord     User         @relation("LandlordProperties", fields: [landlordId], references: [id], onDelete: Cascade)
  title        String
  description  String
  address      String
  city         String
  area         String
  propertyType PropertyType @default(FLAT)
  rentAmount   Float
  bedrooms     Int          @default(1)
  bathrooms    Int          @default(1)
  isAvailable  Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  utilityBills UtilityBill[]

  @@index([city, area])
  @@index([propertyType])
  @@index([isAvailable])
}

// Model: UtilityBill (Mess / Flat utility calculation & splitting)
model UtilityBill {
  id              String           @id @default(uuid())
  propertyId      String
  property        Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  landlordId      String
  landlord        User             @relation("LandlordUtilityBills", fields: [landlordId], references: [id], onDelete: Cascade)
  month           String
  year            Int
  electricityBill Float            @default(0)
  gasBill         Float            @default(0)
  waterBill       Float            @default(0)
  maidSalary      Float            @default(0)
  totalAmount     Float
  perTenantShare  Float
  status          UtilityStatus    @default(UNPAID)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  utilityPayments UtilityPayment[]

  @@index([propertyId])
  @@index([month, year])
}

// Model: UtilityPayment (Individual tenant payment record)
model UtilityPayment {
  id            String        @id @default(uuid())
  utilityBillId String
  utilityBill   UtilityBill   @relation(fields: [utilityBillId], references: [id], onDelete: Cascade)
  tenantId      String
  tenant        User          @relation("TenantUtilityPayments", fields: [tenantId], references: [id], onDelete: Cascade)
  amount        Float
  paymentStatus PaymentStatus @default(INITIATED)
  transactionId String?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([tenantId])
  @@index([utilityBillId])
}

// Model: Vehicle (Pickup trucks, vans, cars, microbuses)
model Vehicle {
  id           String             @id @default(uuid())
  ownerId      String
  owner        User               @relation("OwnerVehicles", fields: [ownerId], references: [id], onDelete: Cascade)
  title        String
  vehicleType  VehicleType
  licensePlate String             @unique
  capacity     String
  driverName   String
  driverPhone  String
  hourlyRate   Float
  perKmRate    Float
  isAvailable  Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  deletedAt    DateTime?

  bookings     TransportBooking[]

  @@index([vehicleType])
  @@index([isAvailable])
}

// Model: TransportBooking (House-shifting & passenger trip booking)
model TransportBooking {
  id             String        @id @default(uuid())
  tenantId       String
  tenant         User          @relation("TenantBookings", fields: [tenantId], references: [id], onDelete: Cascade)
  vehicleId      String
  vehicle        Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  bookingType    BookingType   @default(HOUSE_SHIFTING)
  pickupAddress  String
  dropoffAddress String
  shiftingDate   DateTime
  laborCount     Int           @default(0)
  totalAmount    Float
  escrowStatus   EscrowStatus  @default(HELD)
  status         BookingStatus @default(PENDING)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([tenantId])
  @@index([vehicleId])
  @@index([status])
}

// Model: Payment (bKash, Stripe, SSLCommerz transactions)
model Payment {
  id            String         @id @default(uuid())
  userId        String
  user          User           @relation("UserPayments", fields: [userId], references: [id], onDelete: Cascade)
  amount        Float
  paymentType   PaymentType
  referenceId   String
  gateway       PaymentGateway @default(BKASH)
  transactionId String         @unique
  status        PaymentStatus  @default(INITIATED)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([userId])
  @@index([transactionId])
  @@index([status])
}

// Model: AuditLog (System activity & change tracking)
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity])
}
